{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${modAuthor}"
  ],
  "contact": {
    "homepage": "https://almostreliable.com/",
    "sources": "https://github.com/${githubUser}/${githubRepo}"
  },
  "license": "${license}",
  "icon": "assets/${modId}/icon.png",
  "environment": "*",
  "entrypoints": {
    "ae2": [
      "com.almostreliable.lazierae2.fabric.FabricInitializer"
    ],
    "ae2:client": [
      "com.almostreliable.lazierae2.fabric.FabricClientInitializer"
    ],
    "fabric-datagen": [
      "com.almostreliable.lazierae2.fabric.data.DataGeneration"
    ]
  },
  "mixins": [
    "lazierae2-common.mixins.json"
  ],
  "depends": {
    "fabric": ">=${fabricApiVersion}",
    "minecraft": ">=${minecraftVersion}",
    "ae2": ">=${aeVersion}",
    "java": ">=17"
  }
}
